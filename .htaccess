# Disable directory listing & content negotiation quirks
Options -Indexes -MultiViews

# Front controller: route everything to index.php unless a real file/dir exists
RewriteEngine On

# Never expose local Docker helper files from Apache document roots
RewriteRule ^docker(/|$) - [F,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route API / console / UI to index.php (single entry)
RewriteRule ^(api/.*|console/.*|ui/.*)?$ index.php [L,QSA]

# Fallback: anything else -> index.php
RewriteRule ^ index.php [L,QSA]
